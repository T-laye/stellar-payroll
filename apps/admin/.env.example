# Copy to .env.local. On Vercel, set only what you want to override.

# Data source: "mock" (the default: the in-browser demo backend; sign in with admin@payorbit.com /
# Password1) or "live" (the PayOrbit API; only platform-admin accounts can sign in).
# NEXT_PUBLIC_API_SOURCE=live

# The browser calls this app's /api/v1 proxy (next.config.ts), which forwards here.
# Defaults to https://settle.getpayorbit.com/api/v1.
# API_PROXY_TARGET=http://localhost:8080/api/v1
