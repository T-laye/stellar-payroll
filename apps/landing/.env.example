# Copy to .env.local. Nothing here is required: every URL has a default per environment
# (src/lib/site.ts): on Vercel → the deployment host and /app, dev → localhost.

# This site's canonical URL (metadata, robots). Set it once PayOrbit has its production domain.
# NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Where "Sign In" / "Get Started" and the old app paths (/auth, /dashboard) go (apps/web).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
