# Copy to .env.local. On Vercel, set only what you want to override.

# Data source: "mock" (the default for now: a demo company in the browser, every screen and payroll
# state explorable; sign in with demo@payorbit.com / Password1) or "live" (the PayOrbit API).
# NEXT_PUBLIC_API_SOURCE=live

# PayOrbit API. The browser calls this app's /api/v1 proxy (next.config.ts), which forwards here.
# Defaults to https://payorbit-production.up.railway.app/api/v1.
# API_PROXY_TARGET=http://localhost:8080/api/v1
# Or force direct calls (the API must allow this origin in CORS). NEXT_PUBLIC_API_BASE_URL is the old name.
# NEXT_PUBLIC_API_URL=https://payorbit-production.up.railway.app/api/v1

# Canonical URLs (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002
